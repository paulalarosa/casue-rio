# Copie para .env.local e preencha. Os dois valores aparecem em sanity.io/manage.
# Nao sao segredo: a chave publica da Sanity so le, e so o que esta publicado.
# Vazios, o site compila igual e a revista mostra que o primeiro texto nao saiu.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Medição de audiência. VAZIA = o site não carrega nada do Google, não cria
# cookie nenhum e não mostra faixa de consentimento, que é o estado de hoje.
# Preenchida com o identificador do GA4 (formato G-XXXXXXX), ligam de uma vez
# o script, a faixa e o trecho de cookies da página de privacidade.
NEXT_PUBLIC_GA_ID=

# Endereco da funcao que recebe os formularios e manda por e-mail. VAZIA = os
# tres formularios validam e avisam que o envio ainda nao esta ligado.
NEXT_PUBLIC_FORM_URL=

# Chave publica do Turnstile, o verificador da Cloudflare. VAZIA = os
# formularios funcionam sem ele. O segredo mora no Lambda, nunca aqui.
NEXT_PUBLIC_TURNSTILE_KEY=
