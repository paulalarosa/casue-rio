{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SincronizarOSite",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::casuerio-site-prod",
        "arn:aws:s3:::casuerio-site-prod/*"
      ]
    },
    {
      "Sid": "LimparOCache",
      "Effect": "Allow",
      "Action": ["cloudfront:CreateInvalidation", "cloudfront:GetInvalidation"],
      "Resource": "*"
    }
  ]
}
