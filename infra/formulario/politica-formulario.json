{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "MandarSoPeloRemetenteDoSite",
      "Effect": "Allow",
      "Action": ["ses:SendEmail"],
      "Resource": "arn:aws:ses:us-east-1:751647213647:identity/casuerio.com.br",
      "Condition": {
        "StringEquals": {
          "ses:FromAddress": "site@casuerio.com.br",
          "ses:Recipients": "rio.casue@gmail.com"
        }
      }
    }
  ]
}
