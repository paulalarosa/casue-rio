{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "MandarSoDoSiteParaACaixaDaCasa",
      "Effect": "Allow",
      "Action": ["ses:SendEmail"],
      "Resource": [
        "arn:aws:ses:us-east-1:751647213647:identity/casuerio.com.br",
        "arn:aws:ses:us-east-1:751647213647:identity/rio.casue@gmail.com"
      ],
      "Condition": {
        "StringEquals": { "ses:FromAddress": "site@casuerio.com.br" },
        "ForAllValues:StringEquals": { "ses:Recipients": ["rio.casue@gmail.com"] }
      }
    }
  ]
}
